# Supabase project: Project Settings -> API
# Leave empty to run in demo mode with fictional data stored in the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Dealership details printed on contracts (defaults are fictional demo values)
VITE_SELLER_NAME=Musterautohaus GmbH
